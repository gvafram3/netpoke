# NetPoke GCP cluster configuration.
# Copy this file to config.env and edit if needed:
#   cp config.env.example config.env
# config.env is git-ignored so your settings stay local.

# --- GCP project and location ---
GCP_PROJECT="project-3d8cb879-c3cb-4a5d-8b8"
GCP_ZONE="us-central1-a"

# --- VM image (Ubuntu 22.04 LTS, matches SlowPoke's setup) ---
IMAGE_FAMILY="ubuntu-2204-lts"
IMAGE_PROJECT="ubuntu-os-cloud"

# --- Machine sizes ---
# Control plane and the load generator get 4 vCPU / 16 GB each.
# Each service worker gets 2 vCPU / 8 GB. This mirrors the spirit of the
# paper's setup (m5.xlarge control/client + m5.large service workers).
CONTROL_MACHINE="e2-standard-4"
LOADGEN_MACHINE="e2-standard-4"
WORKER_MACHINE="e2-standard-2"

# Number of dedicated service-worker nodes (named worker1 .. workerN).
# 6 is the default 8-VM cluster (1 control + 1 loadgen + 6 workers).
NUM_WORKERS=6

# Boot disk size per VM.
DISK_SIZE="50GB"
DISK_TYPE="pd-balanced"

# --- Naming ---
# All VM names are prefixed with this. The kubernetes node names are fixed
# as: control-plane, loadgen, worker1 .. workerN (so the benchmark YAMLs
# that pin services to worker1, worker2, ... keep working).
CLUSTER_PREFIX="netpoke"
NETWORK_TAG="netpoke-cluster"
