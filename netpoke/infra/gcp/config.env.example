# NetPoke GCP cluster configuration.
# Copy this file to config.env and edit if needed:
#   cp config.env.example config.env
# config.env is git-ignored so your settings stay local.

# --- GCP project and location ---
GCP_PROJECT="project-3d8cb879-c3cb-4a5d-8b8"
GCP_ZONE="us-central1-a"
GCP_REGION="us-central1"

# Optional: override zone per VM when nodes are not all in GCP_ZONE.
# Example: loadgen created in us-central1-b while workers are in us-central1-a.
# LOADGEN_ZONE="us-central1-b"
# WORKER3_ZONE="us-central1-a"

# --- VM image (Ubuntu 22.04 LTS, matches SlowPoke's setup) ---
IMAGE_FAMILY="ubuntu-2204-lts"
IMAGE_PROJECT="ubuntu-os-cloud"

# --- Machine sizes ---
# Sized to fit a default GCP project's 12-vCPU global quota (CPUS_ALL_REGIONS).
# The control plane gets 2 vCPU (the kubeadm minimum), the load generator gets
# 4 vCPU so the wrk client never becomes the bottleneck, and each of the 3
# service workers gets 2 vCPU. Total = 2 + 4 + (3 x 2) = 12 vCPU.
# This requires slowpoke-vm to be STOPPED during cluster runs so its 4 vCPU are
# free; provisioning is therefore run from Cloud Shell, not from slowpoke-vm.
CONTROL_MACHINE="e2-standard-2"
LOADGEN_MACHINE="e2-standard-4"
WORKER_MACHINE="e2-standard-2"

# Number of dedicated service-worker nodes (named worker1 .. workerN).
# 3 keeps the total within the 12-vCPU quota (1 control + 1 loadgen + 3 workers).
# If you later raise the project's vCPU quota, increase this for more workers.
NUM_WORKERS=3

# Boot disk size per VM.
DISK_SIZE="50GB"
DISK_TYPE="pd-balanced"

# --- Naming ---
# All VM names are prefixed with this. The kubernetes node names are fixed
# as: control-plane, loadgen, worker1 .. workerN (so the benchmark YAMLs
# that pin services to worker1, worker2, ... keep working).
CLUSTER_PREFIX="netpoke"
NETWORK_TAG="netpoke-cluster"
