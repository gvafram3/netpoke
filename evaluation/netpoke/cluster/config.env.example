# NetPoke cluster configuration.  Copy to cluster/config.env (git-ignored) and fill in.
# Four Ubuntu machines on AWS EC2 (see INSTRUCTIONS.md, "Cluster setup").
SSH_USER="ubuntu"                       # default user of the Ubuntu AMI
SSH_KEY="$HOME/.ssh/netpoke.pem"        # private key file (NEVER commit it; .gitignore blocks *.pem)
NODES="control worker0 worker1 worker2" # names are FIXED: the authors' yamls pin services to worker0/1/2
IP_control=""                           # PUBLIC IPv4 of each machine. Public IPs change after every stop/start.
IP_worker0=""
IP_worker1=""
IP_worker2=""
CNI="weave"                             # weave = the authors' choice. If weave pods crash-loop on Ubuntu 24.04: flannel
